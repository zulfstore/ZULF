# ==============================================================================
# ZULF STORE - Environment Configuration
# ==============================================================================

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Postgres Database, Auth & Storage)
# Required for production persistence. Found in Supabase Project Settings -> API.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# Server-side service role key (Never expose in client code)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# PAKISTAN PAYMENT GATEWAYS (Phase 2 Onboarding)
# PayFast Pakistan online card & wallet checkout integration.
# ------------------------------------------------------------------------------
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_SANDBOX_MODE="true"

# ------------------------------------------------------------------------------
# PAKISTAN COURIER LOGISTICS (Phase 2 Direct API Booking)
# Trax / TCS / Leopards tracking & dispatch APIs.
# ------------------------------------------------------------------------------
TRAX_API_KEY=""
LEOPARDS_API_KEY=""
TCS_API_KEY=""
